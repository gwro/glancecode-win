{
  "name": "@gwro/glancecode-win",
  "version": "0.6.2",
  "description": "Drive your Claude Code sessions from Even Realities G2 smart glasses, natively on Windows: live transcript, approvals, and hold-to-talk voice.",
  "type": "module",
  "bin": {
    "glancecode": "bin/glancecode"
  },
  "files": [
    "bin/glancecode",
    "bin/glancecode-hook.mjs",
    "host/",
    "hub/",
    "app/dist/",
    "docs/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && npm test --prefix app",
    "test:hub": "node --test test/*.test.mjs",
    "build:app": "npm ci --prefix app && npm run build --prefix app",
    "pack:app": "npm run pack:store --prefix app",
    "prepack": "npm run build:app",
    "pack:personal": "npm run pack --prefix app"
  },
  "keywords": [
    "claude-code",
    "even-realities",
    "g2",
    "smart-glasses",
    "windows",
    "conpty",
    "even-hub"
  ],
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "private": true
}
