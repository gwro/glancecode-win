#!/usr/bin/env node
// glancecode: set up and run the hub, and start or attach Claude Code sessions in the host.
import { spawnSync } from "node:child_process";
import { copyFileSync, existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
// Windows absolute paths are not import specifiers; go through file:// URLs.
const load = (...p) => import(pathToFileURL(join(ROOT, ...p)).href);
const { BRAND } = await load("hub", "brand.mjs");
const { CLAUDE_SETTINGS, LOG_DIR, loadConfig, tailscaleAddress } = await load("hub", "config.mjs");
const { HostClient, attach, ensureHost, pipeAnswers, resolveClaude } = await load("host", "client.mjs");
const PKG = JSON.parse(readFileSync(join(ROOT, "package.json"), "utf8"));

const CLI = BRAND.name;
const HOOK_SCRIPT = join(ROOT, "bin", `${CLI}-hook.mjs`);
// Claude Code runs the hook through PowerShell (forced with `shell`, so it is the
// same with or without Git Bash). PowerShell's $PID lets the hub find Claude's pid.
const HOOK_COMMAND = `& "${process.execPath}" "${HOOK_SCRIPT}" $PID`;
const HOOK_EVENTS = [
  "SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "PostToolUseFailure",
  "PermissionDenied", "Notification", "Stop", "StopFailure", "SessionEnd",
];
const WIN = process.platform === "win32";

const [cmd = "help", ...rest] = process.argv.slice(2);

const ok = (s) => console.log(`  ✓ ${s}`);
const warn = (s) => console.log(`  ! ${s}`);
const info = (s) => console.log(`    ${s}`);

const commands = {
  // ---------- one-shot setup ----------
  async setup() {
    console.log(`${BRAND.displayName} setup\n`);
    const problems = await checkPrerequisites();
    if (problems.blocking) {
      console.log("\nFix the items above, then run setup again.");
      process.exit(1);
    }
    console.log("\nHooks");
    commands.install({ quiet: true });
    console.log("\nVoice");
    await commands["setup-voice"]();
    console.log("\nBackground service");
    commands.service("install");
    console.log("\nHTTPS for the glasses app");
    const served = commands.serve("on", { quiet: true });
    console.log("\nPairing");
    if (served) commands.pair();
    else info(`After enabling HTTPS, run: ${CLI} serve && ${CLI} pair`);
    console.log(`\nTo let the glasses drive sessions you start at your desk, start Claude with \`${CLI} claude\`.`);
  },

  async doctor() {
    console.log(`${BRAND.displayName} ${PKG.version} doctor\n`);
    const { blocking } = await checkPrerequisites();
    const cfg = loadConfig();
    const settings = readSettings();
    const hooked = HOOK_EVENTS.every((e) => (settings.hooks?.[e] || []).some((g) => (g.hooks || []).some((h) => h.command === HOOK_COMMAND)));
    hooked ? ok("Claude Code hooks installed") : warn(`hooks not installed: ${CLI} install`);
    const stale = staleHookCommands(settings);
    if (stale.length) warn(`hooks point at missing scripts: ${[...new Set(stale)].join(", ")} (run ${CLI} install)`);
    (await pipeAnswers(cfg.hostPipe)) ? ok(`session host running (${cfg.hostPipe})`) : info(`session host not running; it starts with the first \`${CLI} claude\``);
    try {
      const res = await fetch(`http://127.0.0.1:${cfg.port}/api/health`, { signal: AbortSignal.timeout(1500) });
      res.ok ? ok(`hub running on 127.0.0.1:${cfg.port}`) : warn(`hub answered ${res.status}`);
    } catch {
      warn(`hub not running: ${CLI} service install (or ${CLI} hub)`);
    }
    existsSync(cfg.whisperModel) ? ok("speech model present") : warn(`speech model missing: ${CLI} setup-voice`);
    const ts = tailscaleStatus();
    if (!ts) warn("Tailscale not running on this machine");
    else {
      ok(`Tailscale up as ${ts.dnsName}`);
      ts.httpsEnabled ? ok("tailnet HTTPS certificates enabled") : warn("tailnet HTTPS is off: enable it at https://login.tailscale.com/admin/dns");
      serveActive(cfg) ? ok(`tailscale serve on https://${ts.dnsName}:${cfg.httpsPort}`) : warn(`not served over HTTPS: ${CLI} serve`);
    }
    if (blocking) process.exitCode = 1;
  },

  // ---------- hub ----------
  hub() {
    return load("hub", "server.mjs").then(({ startHub }) => {
      const hub = startHub();
      const stop = () => {
        hub.close();
        process.exit(0);
      };
      process.on("SIGINT", stop);
      process.on("SIGTERM", stop);
    });
  },

  // ---------- Claude Code hooks ----------
  install({ quiet = false } = {}) {
    const entry = { type: "command", command: HOOK_COMMAND, shell: "powershell", async: true, timeout: 10 };
    const r = addHooks(CLAUDE_SETTINGS, HOOK_EVENTS, entry);
    if (r.added || r.removed) ok(`hook installed on ${r.added} event(s)${r.removed ? `, ${r.removed} old entr${r.removed === 1 ? "y" : "ies"} removed` : ""} in ${CLAUDE_SETTINGS}`);
    else ok("Claude Code hooks already installed");
    if (!quiet) info("Sessions already open pick it up when their settings reload; restart them if they don't appear.");
  },

  uninstall() {
    const removed = removeHooks(CLAUDE_SETTINGS);
    console.log(`Removed ${removed} ${CLI} hook entr${removed === 1 ? "y" : "ies"}.`);
  },

  // ---------- sessions ----------
  async claude() {
    const claude = resolveClaude();
    if (!claude) {
      console.error("claude not found on PATH. Install Claude Code: https://claude.com/claude-code");
      process.exit(1);
    }
    if (process.env.GLANCECODE_PANE) {
      // Already inside a host session: just run Claude Code here.
      const r = spawnSync(claude.cmd, [...claude.args, ...rest], { stdio: "inherit" });
      process.exit(r.status ?? 0);
    }
    const cfg = loadConfig();
    const cwd = process.cwd();
    await ensureHost(cfg.hostPipe, { logFile: join(LOG_DIR, "host.log") });
    const host = new HostClient(cfg.hostPipe);
    const { id, name } = await host.request("new", {
      name: basename(cwd),
      cwd,
      cmd: claude.cmd,
      args: [...claude.args, ...rest],
      env: { GLANCECODE_HOOK_PORT: String(cfg.hookPort) },
      cols: process.stdout.columns || 120,
      rows: process.stdout.rows || 40,
    });
    await attachAndReport(host, id, name);
  },

  async attach() {
    const cfg = loadConfig();
    const host = new HostClient(cfg.hostPipe);
    const sessions = await hostSessions(host);
    if (!sessions.length) return console.log(`No ${CLI} sessions running.`);
    const want = rest[0];
    const target = want ? sessions.find((s) => s.name === want || s.id === want) || sessions.find((s) => s.name.startsWith(want)) : sessions.length === 1 ? sessions[0] : null;
    if (!target) {
      console.log("Sessions:");
      for (const s of sessions) console.log(`  ${s.name.padEnd(24)} ${s.attached ? "attached" : ""}`);
      console.log(`\n${CLI} attach <name>`);
      return;
    }
    await attachAndReport(host, target.id, target.name);
  },

  async ls() {
    const cfg = loadConfig();
    const sessions = await hostSessions(new HostClient(cfg.hostPipe));
    if (!sessions.length) return console.log(`No ${CLI} sessions running.`);
    for (const s of sessions) console.log(`${s.name.padEnd(24)} ${s.cwd}${s.attached ? "  (attached)" : ""}`);
    process.exit(0);
  },

  async feed() {
    const cfg = loadConfig();
    const { printFeed, printState } = await load("hub", "feed.mjs");
    const base = `http://127.0.0.1:${cfg.port}`;
    const headers = { Authorization: `Bearer ${cfg.token}` };
    const known = new Map();
    let since = 0;
    for (;;) {
      try {
        const state = await (await fetch(`${base}/api/state`, { headers })).json();
        if (!since) {
          since = state.seq;
          console.log(`Watching ${state.sessions.length} session(s). Ctrl-C to stop.`);
        }
        for (const s of state.sessions) known.set(s.id, s);
        const res = await fetch(`${base}/api/events?since=${since}`, { headers });
        const decoder = new TextDecoder();
        let buf = "";
        for await (const chunk of res.body) {
          buf += decoder.decode(chunk, { stream: true });
          let idx;
          while ((idx = buf.indexOf("\n\n")) >= 0) {
            const block = buf.slice(0, idx);
            buf = buf.slice(idx + 2);
            const id = /^id: (\d+)$/m.exec(block)?.[1];
            const data = /^data: (.*)$/m.exec(block)?.[1];
            if (id) since = Number(id);
            if (!data) continue;
            const ev = JSON.parse(data);
            if (ev.type === "session") {
              printState(ev.session, known.get(ev.session.id));
              known.set(ev.session.id, ev.session);
            } else if (ev.type === "items") {
              printFeed(known.get(ev.id) || { project: ev.id.slice(0, 8) }, ev.items);
            }
          }
        }
      } catch {
        /* hub restarting */
      }
      await new Promise((r) => setTimeout(r, 2000));
    }
  },

  async status() {
    const cfg = loadConfig();
    try {
      const res = await fetch(`http://127.0.0.1:${cfg.port}/api/state`, { headers: { Authorization: `Bearer ${cfg.token}` }, signal: AbortSignal.timeout(1500) });
      const { sessions } = await res.json();
      console.log(`hub: running, ${sessions.length} session(s)`);
      for (const s of sessions) console.log(`  ${s.project.padEnd(16)} ${s.state.padEnd(8)} ${s.controllable ? "live" : "view-only"}  ${s.activity || ""}`);
    } catch {
      console.log(`hub: not running (${CLI} service install, or ${CLI} hub)`);
    }
    console.log(`run \`${CLI} doctor\` for a full check`);
  },

  // ---------- service ----------
  service(sub = rest[0] || "status") {
    // Task Scheduler support lands in the next milestone.
    warn(`\`${CLI} service ${sub}\` isn't available yet on Windows. Run the hub in a terminal for now: ${CLI} hub`);
    return false;
  },

  // ---------- HTTPS through tailscale serve ----------
  serve(sub = rest[0] || "on", { quiet = false } = {}) {
    const cfg = loadConfig();
    const ts = tailscaleStatus();
    if (!ts) {
      warn("Tailscale is not running on this machine. Install it and sign in: https://tailscale.com/download");
      return false;
    }
    if (sub === "off") {
      runTailscale(["serve", `--https=${cfg.httpsPort}`, "off"]);
      ok("stopped serving over HTTPS");
      return true;
    }
    if (sub === "status") {
      serveActive(cfg) ? ok(`serving https://${ts.dnsName}:${cfg.httpsPort}`) : warn("not serving");
      return serveActive(cfg);
    }
    if (!ts.httpsEnabled) {
      warn("HTTPS certificates are off for your tailnet.");
      info("Turn on HTTPS at https://login.tailscale.com/admin/dns (one click), then run this again.");
      return false;
    }
    const r = runTailscale(["serve", "--bg", `--https=${cfg.httpsPort}`, `http://127.0.0.1:${cfg.port}`]);
    if (r.status !== 0) {
      warn(`tailscale serve failed: ${(r.stderr || r.stdout || "").trim()}`);
      return false;
    }
    ok(`serving the hub at https://${ts.dnsName}:${cfg.httpsPort}`);
    if (!quiet) info(`Pair the glasses app: ${CLI} pair`);
    return true;
  },

  // ---------- pairing ----------
  pair() {
    const cfg = loadConfig();
    const url = hubUrl(cfg);
    if (!url) {
      warn(`No reachable address for the phone. Run: ${CLI} serve`);
      return;
    }
    const code = `${url}#${cfg.token}`;
    console.log(`Pairing code (paste it on the phone screen of the ${BRAND.displayName} app):\n`);
    console.log(`  ${code}\n`);
    info("Anyone with this code and access to your tailnet can type into your sessions. Keep it private.");
    if (rest.includes("--dev")) {
      const appUrl = `${url}/?hub=${encodeURIComponent(url)}&token=${encodeURIComponent(cfg.token)}`;
      console.log("\nDevelopment sideload (Even app > Even Hub > developer > Scan QR):");
      const r = spawnSync("npx", ["--yes", "@evenrealities/evenhub-cli", "qr", "--url", appUrl], { stdio: "inherit", shell: WIN });
      if (r.status !== 0) console.log(appUrl);
    }
  },

  // ---------- voice ----------
  async "setup-voice"() {
    const cfg = loadConfig();
    if (existsSync(cfg.whisperModel) && (!/[\\/]/.test(cfg.whisperBin) || existsSync(cfg.whisperBin))) {
      ok(`speech model present (${basename(cfg.whisperModel)})`);
      return;
    }
    // Downloading whisper.cpp's Windows build and the model lands in a later milestone.
    warn("voice setup isn't available yet on Windows; hold to talk stays off for now");
  },

  version() {
    console.log(`${CLI} ${PKG.version}`);
  },

  help() {
    console.log(`${CLI} ${PKG.version} - ${BRAND.tagline}

Setup
  ${CLI} setup              install hooks, voice, background service and HTTPS, then pair
  ${CLI} doctor             check every piece and say what to fix
  ${CLI} pair               pairing code for the glasses app (--dev adds a sideload QR)

Sessions
  ${CLI} claude [args]      start Claude Code in the session host so the glasses can drive it
  ${CLI} attach [name]      open a running session in this terminal (Ctrl+] detaches)
  ${CLI} ls                 list sessions
  ${CLI} feed               live feed of every session
  ${CLI} status             hub and sessions

Pieces
  ${CLI} install|uninstall  add or remove the Claude Code hook
  ${CLI} service [install|uninstall|restart|status]
  ${CLI} serve [on|off|status]   HTTPS on your *.ts.net name through tailscale serve
  ${CLI} hub                run the hub in the foreground
  ${CLI} setup-voice        download the local speech model`);
  },
};

// ---------- sessions ----------

async function hostSessions(host) {
  try {
    return (await host.request("list")).sessions;
  } catch {
    return []; // no host running
  } finally {
    host.close();
  }
}

/** Attach this console to a session, then say what happened when it ends or detaches. */
async function attachAndReport(host, id, name) {
  const result = await attach({ pipe: host.pipe, id });
  host.close();
  process.stdout.write("\x1b[0m\r\n");
  if (result.reason === "detached") console.log(`Detached. The session keeps running: ${CLI} attach ${name}`);
  else {
    const still = await pipeAnswers(host.pipe) && (await new HostClient(host.pipe).request("alive", { session: id }).catch(() => ({ alive: false }))).alive;
    if (still) console.log(`Connection lost. The session keeps running: ${CLI} attach ${name}`);
  }
  process.exit(0);
}

// ---------- prerequisites ----------

async function checkPrerequisites() {
  let blocking = false;
  const [major] = process.versions.node.split(".").map(Number);
  if (major >= 20) ok(`Node ${process.versions.node}`);
  else {
    warn(`Node ${process.versions.node} is too old; need 20 or newer`);
    blocking = true;
  }
  const claude = resolveClaude();
  if (claude) ok(`Claude Code found (${claude.display})`);
  else {
    warn("Claude Code not found on PATH: https://claude.com/claude-code");
    blocking = true;
  }
  const cfg = loadConfig();
  existsSync(cfg.whisperBin) || commandExists(cfg.whisperBin) ? ok("whisper.cpp found") : warn(`whisper.cpp not found (optional, for voice): ${CLI} setup-voice`);
  tailscaleStatus() ? ok("Tailscale running") : warn("Tailscale not running (needed for the phone to reach this machine)");
  return { blocking };
}

function commandExists(name) {
  if (/[\\/]/.test(name)) return existsSync(name);
  return spawnSync(WIN ? "where.exe" : "which", [name], { stdio: "ignore" }).status === 0;
}

// ---------- tailscale ----------

function tailscaleBin() {
  if (commandExists("tailscale")) return "tailscale";
  const candidates = WIN ? [join(process.env.ProgramFiles || "C:\\Program Files", "Tailscale", "tailscale.exe")] : ["/Applications/Tailscale.app/Contents/MacOS/Tailscale"];
  return candidates.find((p) => existsSync(p)) || null;
}

function runTailscale(args) {
  const bin = tailscaleBin();
  if (!bin) return { status: 1, stderr: "tailscale not installed" };
  return spawnSync(bin, args, { encoding: "utf8", windowsHide: true });
}

function tailscaleStatus() {
  const r = runTailscale(["status", "--json"]);
  if (r.status !== 0) return null;
  try {
    const s = JSON.parse(r.stdout);
    if (s.BackendState && s.BackendState !== "Running") return null;
    return {
      dnsName: String(s.Self?.DNSName || "").replace(/\.$/, ""),
      ip: s.Self?.TailscaleIPs?.find((a) => a.includes(".")) || null,
      httpsEnabled: Array.isArray(s.CertDomains) && s.CertDomains.length > 0,
    };
  } catch {
    return null;
  }
}

function serveActive(cfg) {
  const r = runTailscale(["serve", "status", "--json"]);
  if (r.status !== 0) return false;
  try {
    const s = JSON.parse(r.stdout || "{}");
    return Object.keys(s.TCP || {}).includes(String(cfg.httpsPort));
  } catch {
    return false;
  }
}

/** The address the phone should use: HTTPS through tailscale serve, else the raw IP if enabled. */
function hubUrl(cfg) {
  const ts = tailscaleStatus();
  if (ts && serveActive(cfg)) return `https://${ts.dnsName}:${cfg.httpsPort}`;
  const ip = cfg.bindTailscaleIP ? tailscaleAddress() : null;
  return ip ? `http://${ip}:${cfg.port}` : null;
}

// ---------- hooks in settings.json ----------

function isOurHook(command) {
  return typeof command === "string" && (command.includes(`${CLI}-hook`) || BRAND.legacy.hookScripts.some((h) => command.includes(h)));
}

/** The script path inside one of our hook commands, for the stale check. */
function hookScriptPath(command) {
  return /"([^"]*glancecode-hook[^"]*)"/.exec(command)?.[1] || null;
}

function staleHookCommands(settings) {
  const out = [];
  for (const groups of Object.values(settings.hooks || {})) {
    for (const g of groups) {
      for (const h of g.hooks || []) {
        if (!isOurHook(h.command)) continue;
        const script = hookScriptPath(h.command);
        if (script && !existsSync(script)) out.push(script);
      }
    }
  }
  return out;
}

function readSettings(path = CLAUDE_SETTINGS) {
  if (!existsSync(path)) return {};
  return JSON.parse(readFileSync(path, "utf8"));
}

function writeSettings(settings, path = CLAUDE_SETTINGS) {
  mkdirSync(dirname(path), { recursive: true });
  if (existsSync(path)) copyFileSync(path, `${path}.bak-${CLI}`);
  const tmp = path + ".tmp";
  writeFileSync(tmp, JSON.stringify(settings, null, 2) + "\n");
  renameSync(tmp, path);
}

/** Put our hook on each event in a settings file, dropping entries from older installs. */
function addHooks(path, events, entry) {
  const settings = readSettings(path);
  settings.hooks ||= {};
  let added = 0;
  let removed = 0;
  for (const event of events) {
    const groups = (settings.hooks[event] ||= []);
    for (const g of groups) {
      const before = (g.hooks || []).length;
      g.hooks = (g.hooks || []).filter((h) => !isOurHook(h.command) || h.command === entry.command);
      removed += before - g.hooks.length;
    }
    settings.hooks[event] = groups.filter((g) => (g.hooks || []).length);
    if (!settings.hooks[event].some((g) => g.hooks.some((h) => h.command === entry.command))) {
      settings.hooks[event].push({ hooks: [entry] });
      added++;
    }
  }
  if (added || removed) writeSettings(settings, path);
  return { added, removed };
}

function removeHooks(path) {
  const settings = readSettings(path);
  let removed = 0;
  for (const [event, groups] of Object.entries(settings.hooks || {})) {
    const kept = groups.map((g) => ({ ...g, hooks: (g.hooks || []).filter((h) => !isOurHook(h.command)) })).filter((g) => g.hooks.length);
    removed += groups.reduce((n, g) => n + (g.hooks || []).length, 0) - kept.reduce((n, g) => n + g.hooks.length, 0);
    if (kept.length) settings.hooks[event] = kept;
    else delete settings.hooks[event];
  }
  if (removed) writeSettings(settings, path);
  return removed;
}

const fn = commands[cmd] || (cmd === "--version" || cmd === "-v" ? commands.version : null);
if (!fn) {
  commands.help();
  process.exit(cmd === "help" || cmd === "--help" || cmd === "-h" ? 0 : 1);
}
await fn();
